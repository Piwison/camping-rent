# Booking enquiries are stored in Postgres via the Supabase config below
# (ADR-0007). Without Supabase configured, enquiries are logged server-side so
# the booking flow still works in local development. (Enquiries previously went
# to Notion — ADR-0003, now superseded.)

# Canonical site origin (no trailing slash). Used for absolute URLs in
# metadata, sitemap.xml, and robots.txt. Defaults to http://localhost:3000.
# Set this to your production domain at build time, e.g. https://basecamp.tw
NEXT_PUBLIC_SITE_URL=

# Supabase — Phase 2 datastore for the Catalog and Enquiries (ADR-0006/0007).
# Find these in your Supabase project: Settings → API.
#   1. Run the schema: supabase/migrations/20260529120000_init.sql (the GitHub
#      integration applies it on merge; or paste it in the SQL editor).
#   2. Set the values below in .env.local (the service-role key is secret —
#      server-only, never expose it to the client or commit it).
#   3. Seed from the current Catalog: npm run seed
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vendor + Customer auth (Supabase Auth, email + password — ADR-0006/0010). The
# browser and server auth clients use the anon (publishable) key; safe to expose.
#   1. Same project as above; URL is identical to SUPABASE_URL.
#   2. Create the Vendor account: Supabase dashboard → Authentication → Users →
#      Add user (email + password). Customers self-serve at /account/login.
# When these are unset, /admin and /account stay open (no lock-out in un-wired
# local dev).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Which account(s) are the Vendor (comma-separated emails). REQUIRED once
# Customer sign-ups are open (ADR-0010) — every signed-in user NOT on this list
# is treated as a Customer. If unset, the Vendor guard falls back to "any
# signed-in user" (with a server warning), which is insecure with public sign-up.
#   e.g. VENDOR_EMAILS=owner@basecamp.tw
VENDOR_EMAILS=

# Online deposits via ECPay 綠界 (ADR-0011). With nothing set, the app uses
# ECPay's public SANDBOX test merchant so deposits work end-to-end without real
# credentials (no real money moves). For production, set ECPAY_MODE=production
# AND all three live merchant values from your ECPay account.
#   - ECPay's server-to-server callback must reach /api/payment/ecpay/callback,
#     so a public NEXT_PUBLIC_SITE_URL (or deployed origin) is required to test
#     the full settle loop — localhost won't receive it.
ECPAY_MODE=
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=

# Deposit charged online to secure a booking, as a percent of the total.
# NEXT_PUBLIC_ so the booking UI shows the same figure the server charges.
# Defaults to 30.
NEXT_PUBLIC_DEPOSIT_PERCENT=

# Automated emails: confirmations + reminders via Resend (ADR-0012). Without a
# key, emails are logged server-side and the booking flow is unaffected.
#   - RESEND_API_KEY: from resend.com.
#   - NOTIFY_FROM: a verified sender, e.g. "Basecamp & Co. <hello@basecamp.tw>".
#   - NOTIFY_VENDOR_TO: where new-enquiry alerts go (defaults to the first
#     VENDOR_EMAILS entry).
RESEND_API_KEY=
NOTIFY_FROM=
NOTIFY_VENDOR_TO=

# Pre-trip reminder sweep at /api/cron/reminders (ADR-0012). Set CRON_SECRET and
# call it on a schedule (vercel.json already defines a daily cron; Vercel sends
# the secret as a Bearer token when CRON_SECRET is set). REMINDER_WITHIN_DAYS is
# how many days ahead of check-in to remind (default 2).
CRON_SECRET=
REMINDER_WITHIN_DAYS=
